# vignettes/articles/ is the pkgdown convention for web-only articles: the
# site renders them, the tarball does not carry them. They used to live in a
# top-level articles/ directory, which neither chain reached -- excluded from
# the build AND not a directory pkgdown renders -- so all four went unbuilt
# for as long as they existed, and all four were broken.
^vignettes/articles$
^cheatsheets$
^INTRO\.md$
^RELEASE-CHECKLIST-v3\.10\.0\.md$
^CONTRIBUTING\.md$
^CODE_OF_CONDUCT\.md$
^SECURITY\.md$
^STATUS\.md$
^\.git$
^figure$
^paper$
^.*\.Rproj$
^\.Rproj\.user$
^\.positai$
^manuscript$
^paper/S2_File_pipeline\.zip$
