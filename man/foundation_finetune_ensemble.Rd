  soc_m <- matrix(br_cerrado$soc, g, g)
  ij <- expand.grid(i = seq(1L, g - p + 1L, by = 6L),
                    j = seq(1L, g - p + 1L, by = 6L))
  x <- array(0, dim = c(nrow(ij), 4L, p, p))
  y <- numeric(nrow(ij))
