emb <- cbind(
  matrix(canopy, n, 8)           + matrix(rnorm(n * 8, 0, 0.5), n),
  matrix(scale(carbonate), n, 2) + matrix(rnorm(n * 2, 0, 0.5), n),
  matrix(scale(quarry_km), n, 2) + matrix(rnorm(n * 2, 0, 0.5), n)
