    sequence = past_seq,
    target   = array(past_tgt[1L, 9L, , ], dim = c(1L, 8L, 8L)),
    hidden_dims = 4L, epochs = 3L, K_ens = 2L, base_seed = 7L)
  print(tryCatch(temporal_convlstm_ensemble_rollout(
