# and the mixture tracks the physics block more closely.
od <- upper.tri(K)
round(stats::quantile(Kq[od], c(0.5, 0.9, 1)), 4)
round(c(quantum = stats::sd(0.7 * Kq[od]),
        physics = stats::sd(0.3 * Kp[od])), 4)
